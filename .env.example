# Copy this file to `.env.local` for local development.
# Do not commit `.env.local`.

# Public origin for generated URLs.
# Used for canonical links, Markdown exports, llms.txt links, contextual AI
# actions, and the MCP endpoint install URL.
# Local development can use http://localhost:3000. Production should use your
# deployed docs site URL, for example https://docs.example.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional text chat assistant.
# Add a server-side API key to enable the top-bar Chat button. Leave this empty
# if you want search, Markdown exports, llms.txt, generated API pages, and the
# MCP endpoint without AI chat. API usage is billed by your AI provider.
OPENAI_API_KEY=

# Optional. Overrides the default model used by the text chat API route.
# Keep this aligned with a model your API key can access.
OPENAI_MODEL=gpt-5.4-mini

# Optional. Controls how much public docs content the chat assistant receives.
# Increase only if your model has enough context window for your docs corpus.
DOCS_ASSISTANT_MAX_CONTEXT_CHARS=80000

# Optional voice chat assistant.
# Set both booleans to true when you want the browser Talk to docs button.
# The server route still requires OPENAI_API_KEY and returns only an ephemeral
# OpenAI Realtime client secret to the browser.
NEXT_PUBLIC_DOCS_VOICE_ASSISTANT=false
DOCS_VOICE_ASSISTANT_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_VOICE_FEMALE=marin
OPENAI_REALTIME_VOICE_MALE=cedar
NEXT_PUBLIC_OPENAI_REALTIME_VOICE_FEMALE=marin
NEXT_PUBLIC_OPENAI_REALTIME_VOICE_MALE=cedar
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Optional. Adds edit links to pages. Point this at your repository edit URL,
# for example https://github.com/acme/docs/edit/main.
NEXT_PUBLIC_DOCS_EDIT_URL=

# Optional. Posts page feedback to your own endpoint. Leave unset to store the
# local UI state and emit a browser docs:feedback event only.
NEXT_PUBLIC_DOCS_FEEDBACK_ENDPOINT=

# Optional. Enables generic analytics hooks. Use public script URLs and public
# website IDs only.
NEXT_PUBLIC_DOCS_ANALYTICS=false
NEXT_PUBLIC_DOCS_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_DOCS_ANALYTICS_WEBSITE_ID=
